# Allow source, tests and docs only. Local runtime data stays private by default.
*
!*.py
!README.md
!LICENSE
!CHANGELOG.md
!CONTRIBUTING.md
!SECURITY.md
!THIRD_PARTY_NOTICES.md
!requirements.txt
!requirements-tested.txt
!pipeline_settings.example.json
!.gitignore
!.gitattributes
!install_schedule.ps1
!uninstall_schedule.ps1
!scripts/
!scripts/**
!tests/
!tests/**
!docs/
!docs/**
!.github/
!.github/**

# Additional explicit exclusions, even if the source allowlist changes later.
**/__pycache__/
**/.pytest_cache/
/.venv/
/.pipeline/
/.browser_profile/
/data/
/config.local.json
/pipeline_settings.json
/catalog_playurls.json*
/weekly.json
/ppt_清单.json
*.dpapi
*.log
*.wav
*.mp4
*.srt
*.pt
*.onnx
*.bak
*.tmp
*.key
*.pem
.env*
